---
import PlayerIsland from "../player/PlayerIsland.tsx";
import "../styles/global.css";
import "../player/player.css";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="An interactive M8541 music player." />
    <link rel="icon" type="image/svg+xml" href={`${base}/logo.svg`} />
    <link rel="icon" type="image/svg+xml" href={`${base}/logo-dark.svg`} media="(prefers-color-scheme: dark)" />
    <title>M8541</title>
  </head>
  <body>
    <div id="root">
      <main aria-label="M8541 music player">
        <div class="player-container">
          <PlayerIsland catalogUrl={`${base}/catalog.json`} client:only="react" />
        </div>
      </main>
    </div>
  </body>
</html>
