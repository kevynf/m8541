{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "allowJs": false,
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ES2022"
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "tests/**/*",
    "astro.config.mjs",
    "vite.lib.config.mjs"
  ],
  "exclude": ["dist", "lib"]
}
