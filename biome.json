{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "src/**/*.js",
      "src/**/*.jsx",
      "src/**/*.ts",
      "src/**/*.tsx",
      "src/**/*.d.ts",
      "src/**/*.css",
      "tests/**/*.js",
      "tests/**/*.ts",
      "astro.config.mjs",
      "vite.lib.config.mjs",
      "package.json",
      "tsconfig.json",
      "biome.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "assist": { "enabled": false },
  "linter": {
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noNoninteractiveElementInteractions": "off"
      },
      "correctness": {
        "noUndeclaredVariables": "error",
        "noUnreachable": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useHookAtTopLevel": "error",
        "useExhaustiveDependencies": "off"
      },
      "complexity": {
        "useMathMinMax": "off",
        "useOptionalChain": "off"
      },
      "suspicious": {
        "useIterableCallbackReturn": "off",
        "noDebugger": "error",
        "noDuplicateCase": "error",
        "noDuplicateClassMembers": "error",
        "noDuplicateElseIf": "error",
        "noDuplicateJsxProps": "error",
        "noDuplicateObjectKeys": "error",
        "noDuplicateParameters": "error",
        "noFocusedTests": "error",
        "noUnknownAttribute": "error"
      },
      "style": {
        "useDefaultParameterLast": "off",
        "noDescendingSpecificity": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/player/shared/icons/**/*.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off"
          }
        }
      }
    },
    {
      "includes": ["src/player/device/LoadingScreen.tsx", "src/player/device/OverlayScreen.tsx"],
      "linter": {
        "rules": {
          "security": {
            "noDangerouslySetInnerHtml": "off"
          }
        }
      }
    },
    {
      "includes": ["src/player/navigation/MenuList.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noNoninteractiveElementToInteractiveRole": "off",
            "useAriaPropsSupportedByRole": "off"
          }
        }
      }
    },
    {
      "includes": ["src/player/M8541.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noStaticElementInteractions": "off",
            "useKeyWithClickEvents": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/player/M8541.tsx",
        "src/player/playback/NowPlaying.tsx",
        "src/player/wheel/ClickWheel.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off"
          }
        }
      }
    },
    {
      "includes": ["src/player/brick/BrickGame.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noAriaHiddenOnFocusable": "off"
          }
        }
      }
    }
  ]
}
