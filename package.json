{
  "name": "m8541",
  "version": "1.0.0",
  "private": true,
  "description": "A React component recreating the Apple Music iPod anniversary Easter egg",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./style.css": "./lib/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "vite build --config vite.lib.config.mjs",
    "build:demo": "astro build",
    "prepack": "npm run build",
    "preview": "astro preview",
    "check": "biome check . && astro check",
    "format": "biome format --write .",
    "test": "node --test tests/*.test.ts"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/react": "^7.1.1",
    "@biomejs/biome": "2.6.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "astro": "^7.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^6.0.0",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
